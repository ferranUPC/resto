# Copy to .env and fill in the real key there. .env is gitignored — never commit it.

# OpenRouter (https://openrouter.ai). The real ToolAgent implementation (adapters/llm/) calls
# models through OpenRouter's OpenAI-compatible API, not the Anthropic API directly, even though
# the architecture doc's module name predates that choice.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cost policy (see CLAUDE.md "LLM provider & cost policy"): every agent run uses this model
# unless a human has explicitly opted into escalation for that one run. Never repoint this at a
# pricier model as a casual default.
RESTO_LLM_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash

# Left blank on purpose: no escalation model is approved yet. Set it only when a specific task
# genuinely needs a stronger model, and only after the user has confirmed the cost for that task.
RESTO_LLM_ESCALATION_MODEL=

# Request-bank variant pipeline only (eval/request_bank/), never agent runs: models from families not
# under evaluation, approved 2026-09-23 (docs/evaluating-resto.md §5).
RESTO_BANK_GENERATOR_MODEL=qwen/qwen3.5-9b
RESTO_BANK_VERIFIER_MODEL=meta-llama/llama-3.3-70b-instruct

# Conservative per-run caps (Budget.max_tokens / Budget.max_steps, application/ports/llm.py).
# Raise these deliberately for one call that needs it, never by bumping the defaults.
RESTO_LLM_MAX_OUTPUT_TOKENS=2048
RESTO_LLM_MAX_STEPS=6
