# eval/dev-net/demand/generate_demand.sh + verification.ipynb re-create this on every run
eval/dev-net/demand/_runs/

# eval/scenario_matrix/build.py re-creates this on every run (raw per-row SUMO run outputs,
# ~140MB); matrix.db (the DatabaseMCP-stored Scenario/SimulationResult records, KPIs included)
# and matrix-report.md are the durable, committed assets
eval/scenario_matrix/runs/

# eval/question_bank/build.py re-creates this on every run (scratch build_scenario/run_simulation
# staging, re-derived idempotently against eval/scenario_matrix/matrix.db); question-bank.json and
# question-bank-report.md are the durable, committed assets
eval/question_bank/_rebuild/

# eval/expert_benchmark raw runs (answers + full evidence ledgers, large, resumable scratch);
# reports/<name>.md and reports/<name>.json are the committed assets
eval/expert_benchmark/runs/

