{
  "$defs": {
    "ArtifactRef": {
      "description": "Reference to a file in the artifact store, identified by content hash.",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Condition": {
      "description": "Runtime predicate `metric(target) op value` evaluated by the script's `when(...)`.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "op": {
          "$ref": "#/$defs/Operator"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "target",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DeclaredRule": {
      "description": "A rule registered through traci_api's `at_time(...)` / `when(...)`, as data.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "action"
      ],
      "title": "DeclaredRule",
      "type": "object"
    },
    "EdgeTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "edge",
          "default": "edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "edge_id"
      ],
      "title": "EdgeTarget",
      "type": "object"
    },
    "Intervention": {
      "description": "Something that happens *during* a simulation on an unchanged network.\n\nPermanent topology changes are not interventions: see TopologyModification.",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Effect"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeTarget"
            },
            {
              "$ref": "#/$defs/LaneTarget"
            },
            {
              "$ref": "#/$defs/TlsTarget"
            },
            {
              "$ref": "#/$defs/TazTarget"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "type": {
          "$ref": "#/$defs/InterventionType"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionType": {
      "enum": [
        "lane_closure",
        "edge_closure",
        "speed_limit",
        "demand_scale",
        "signal_program",
        "custom"
      ],
      "title": "InterventionType",
      "type": "string"
    },
    "LaneTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "lane",
          "default": "lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "LaneTarget",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "occupancy",
        "speed",
        "vehicle_count"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Operator": {
      "enum": [
        ">",
        ">=",
        "<",
        "<="
      ],
      "title": "Operator",
      "type": "string"
    },
    "RegenerateDemandMechanism": {
      "description": "Intervention implemented by pointing the scenario at a derived Demand (demand_scale).",
      "properties": {
        "demand_id": {
          "title": "Demand Id",
          "type": "string"
        },
        "kind": {
          "const": "regenerate_demand",
          "default": "regenerate_demand",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "demand_id"
      ],
      "title": "RegenerateDemandMechanism",
      "type": "object"
    },
    "RejectedIntervention": {
      "description": "An intervention the Scenario Builder could not implement, with the reason why.\n\nDoD \u00a74.5 forbids silent coercion: an unimplementable spec is reported, never approximated.",
      "properties": {
        "intervention": {
          "$ref": "#/$defs/Intervention"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "intervention",
        "reason"
      ],
      "title": "RejectedIntervention",
      "type": "object"
    },
    "ScriptMechanism": {
      "description": "Intervention implemented inside the scenario's traci_api script.",
      "properties": {
        "kind": {
          "const": "script",
          "default": "script",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ScriptMechanism",
      "type": "object"
    },
    "StaticFileMechanism": {
      "description": "Intervention implemented as a SUMO additional file (rerouter, VSS, TLS program, TAZ).",
      "properties": {
        "file_kind": {
          "enum": [
            "rerouter",
            "vss",
            "tls_program",
            "taz"
          ],
          "title": "File Kind",
          "type": "string"
        },
        "kind": {
          "const": "static_file",
          "default": "static_file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "file_kind",
        "path"
      ],
      "title": "StaticFileMechanism",
      "type": "object"
    },
    "TazTarget": {
      "properties": {
        "kind": {
          "const": "taz",
          "default": "taz",
          "title": "Kind",
          "type": "string"
        },
        "taz_id": {
          "title": "Taz Id",
          "type": "string"
        }
      },
      "required": [
        "taz_id"
      ],
      "title": "TazTarget",
      "type": "object"
    },
    "TimeWindow": {
      "description": "Simulation-time interval in seconds, [start, end).",
      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "TlsTarget": {
      "properties": {
        "kind": {
          "const": "tls",
          "default": "tls",
          "title": "Kind",
          "type": "string"
        },
        "tls_id": {
          "title": "Tls Id",
          "type": "string"
        }
      },
      "required": [
        "tls_id"
      ],
      "title": "TlsTarget",
      "type": "object"
    },
    "TraciScript": {
      "properties": {
        "api_version": {
          "title": "Api Version",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "declared_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeclaredRule"
          },
          "title": "Declared Rules",
          "type": "array"
        },
        "dry_run_ok": {
          "default": false,
          "title": "Dry Run Ok",
          "type": "boolean"
        },
        "lint_ok": {
          "default": false,
          "title": "Lint Ok",
          "type": "boolean"
        }
      },
      "required": [
        "artifact",
        "api_version"
      ],
      "title": "TraciScript",
      "type": "object"
    }
  },
  "description": "Scenario Builder output. `script` may still be failing lint or dry_run here: that is\ninformation the promotion step acts on, whereas a promoted Scenario requires it runnable.",
  "properties": {
    "additional_files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Additional Files",
      "type": "array"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "title": "Interventions",
      "type": "array"
    },
    "mechanisms": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/StaticFileMechanism"
          },
          {
            "$ref": "#/$defs/ScriptMechanism"
          },
          {
            "$ref": "#/$defs/RegenerateDemandMechanism"
          }
        ]
      },
      "title": "Mechanisms",
      "type": "array"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "rejected": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RejectedIntervention"
      },
      "title": "Rejected",
      "type": "array"
    },
    "script": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraciScript"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sumocfg": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "interventions",
    "mechanisms",
    "sumocfg",
    "rationale"
  ],
  "title": "ScenarioDraft",
  "type": "object"
}
