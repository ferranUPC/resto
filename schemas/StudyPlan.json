{
  "$defs": {
    "AddEdge": {
      "description": "`edge_id`, when given, is the id the new edge gets, so an intervention of the same arm can\ntarget it (ADR-0027).",
      "properties": {
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "from_junction": {
          "title": "From Junction",
          "type": "string"
        },
        "kind": {
          "const": "add_edge",
          "default": "add_edge",
          "title": "Kind",
          "type": "string"
        },
        "lanes": {
          "title": "Lanes",
          "type": "integer"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        },
        "to_junction": {
          "title": "To Junction",
          "type": "string"
        }
      },
      "required": [
        "from_junction",
        "to_junction",
        "lanes",
        "speed"
      ],
      "title": "AddEdge",
      "type": "object"
    },
    "BuildScenarioStep": {
      "description": "`arm`, `role` and `purpose` are the planner's: the Executor copies them into the\n`Experiment` this scenario and its runs become (ADR-0025 \u00a75, ADR-0027 \u00a73).",
      "properties": {
        "arm": {
          "title": "Arm",
          "type": "string"
        },
        "context_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Context Tags",
          "type": "array",
          "uniqueItems": true
        },
        "demand_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Demand Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "interventions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "title": "Interventions",
          "type": "array"
        },
        "kind": {
          "const": "build_scenario",
          "default": "build_scenario",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Network Id"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExperimentRole"
        }
      },
      "required": [
        "network_id",
        "demand_id",
        "arm",
        "role",
        "purpose"
      ],
      "title": "BuildScenarioStep",
      "type": "object"
    },
    "Condition": {
      "description": "Runtime predicate `metric(target) op value` evaluated by the script's `when(...)`.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "op": {
          "$ref": "#/$defs/Operator"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "target",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DeriveNetworkStep": {
      "properties": {
        "base_network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Base Network Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "kind": {
          "const": "derive_network",
          "default": "derive_network",
          "title": "Kind",
          "type": "string"
        },
        "max_rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rounds"
        },
        "min_scc_ratio": {
          "default": 0.95,
          "title": "Min Scc Ratio",
          "type": "number"
        },
        "modifications": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemoveEdge"
              },
              {
                "$ref": "#/$defs/AddEdge"
              },
              {
                "$ref": "#/$defs/SetLanes"
              },
              {
                "$ref": "#/$defs/SetSpeed"
              }
            ]
          },
          "title": "Modifications",
          "type": "array"
        },
        "probe_teleport_threshold": {
          "default": 0,
          "title": "Probe Teleport Threshold",
          "type": "integer"
        }
      },
      "required": [
        "base_network_id",
        "modifications"
      ],
      "title": "DeriveNetworkStep",
      "type": "object"
    },
    "EdgeTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "edge",
          "default": "edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "edge_id"
      ],
      "title": "EdgeTarget",
      "type": "object"
    },
    "ExperimentRole": {
      "enum": [
        "baseline",
        "treatment",
        "comparison"
      ],
      "title": "ExperimentRole",
      "type": "string"
    },
    "FromStep": {
      "description": "The id produced by step `step` of the same plan.",
      "properties": {
        "step": {
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "step"
      ],
      "title": "FromStep",
      "type": "object"
    },
    "Intervention": {
      "description": "Something that happens *during* a simulation on an unchanged network.\n\nPermanent topology changes are not interventions: see TopologyModification.",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Effect"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeTarget"
            },
            {
              "$ref": "#/$defs/LaneTarget"
            },
            {
              "$ref": "#/$defs/TlsTarget"
            },
            {
              "$ref": "#/$defs/TazTarget"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "type": {
          "$ref": "#/$defs/InterventionType"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionType": {
      "enum": [
        "lane_closure",
        "edge_closure",
        "speed_limit",
        "demand_scale",
        "signal_program",
        "custom"
      ],
      "title": "InterventionType",
      "type": "string"
    },
    "LaneTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "lane",
          "default": "lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "LaneTarget",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "occupancy",
        "speed",
        "vehicle_count"
      ],
      "title": "Metric",
      "type": "string"
    },
    "ObtainDemandStep": {
      "description": "The Demand Generator resolves the demand for a network an earlier step produced:\n`network_id` is a `FromStep` to that step, never an id or the reference (ADR-0037 \u00a73).\n`StudyPlan` enforces it; the Executor's resolved copy of the step holds the id the\n`FromStep` pointed to. `demand_ref` is the Parser's phrase; none means the request names\nno demand and the specialist asks.",
      "properties": {
        "demand_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Demand Ref"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "obtain_demand",
          "default": "obtain_demand",
          "title": "Kind",
          "type": "string"
        },
        "max_calibration_rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Calibration Rounds"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Network Id"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "tolerance": {
          "default": 0.15,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "network_id",
        "seed"
      ],
      "title": "ObtainDemandStep",
      "type": "object"
    },
    "ObtainNetworkStep": {
      "description": "The Network Author resolves the network the Parser named: it finds a stored one or has one\npromoted from its draft (ADR-0037 \u00a72). `network_ref` is the Parser's text, verbatim.",
      "properties": {
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "kind": {
          "const": "obtain_network",
          "default": "obtain_network",
          "title": "Kind",
          "type": "string"
        },
        "max_rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rounds"
        },
        "min_scc_ratio": {
          "default": 0.95,
          "title": "Min Scc Ratio",
          "type": "number"
        },
        "network_ref": {
          "title": "Network Ref",
          "type": "string"
        },
        "probe_teleport_threshold": {
          "default": 0,
          "title": "Probe Teleport Threshold",
          "type": "integer"
        }
      },
      "required": [
        "network_ref"
      ],
      "title": "ObtainNetworkStep",
      "type": "object"
    },
    "Operator": {
      "enum": [
        ">",
        ">=",
        "<",
        "<="
      ],
      "title": "Operator",
      "type": "string"
    },
    "RemoveEdge": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "remove_edge",
          "default": "remove_edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "edge_id"
      ],
      "title": "RemoveEdge",
      "type": "object"
    },
    "RerouteDemandStep": {
      "description": "The same trips re-routed on another network (deterministic, no agent).",
      "properties": {
        "demand_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Demand Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "reroute_demand",
          "default": "reroute_demand",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Network Id"
        }
      },
      "required": [
        "demand_id",
        "network_id"
      ],
      "title": "RerouteDemandStep",
      "type": "object"
    },
    "RunSimulationStep": {
      "description": "`seeds=None` means the Executor's `DEFAULT_SEEDS`; one result per seed.",
      "properties": {
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "run_simulation",
          "default": "run_simulation",
          "title": "Kind",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Scenario Id"
        },
        "seeds": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seeds"
        }
      },
      "required": [
        "scenario_id"
      ],
      "title": "RunSimulationStep",
      "type": "object"
    },
    "SetLanes": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "set_lanes",
          "default": "set_lanes",
          "title": "Kind",
          "type": "string"
        },
        "lanes": {
          "title": "Lanes",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lanes"
      ],
      "title": "SetLanes",
      "type": "object"
    },
    "SetSpeed": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "set_speed",
          "default": "set_speed",
          "title": "Kind",
          "type": "string"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "edge_id",
        "speed"
      ],
      "title": "SetSpeed",
      "type": "object"
    },
    "TazTarget": {
      "properties": {
        "kind": {
          "const": "taz",
          "default": "taz",
          "title": "Kind",
          "type": "string"
        },
        "taz_id": {
          "title": "Taz Id",
          "type": "string"
        }
      },
      "required": [
        "taz_id"
      ],
      "title": "TazTarget",
      "type": "object"
    },
    "TimeWindow": {
      "description": "Time of day in seconds since midnight, [start, end): 08:00\u201309:00 is [28800, 32400).\nSimulations run on the same clock (ADR-0028); past midnight the count continues.",
      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "TlsTarget": {
      "properties": {
        "kind": {
          "const": "tls",
          "default": "tls",
          "title": "Kind",
          "type": "string"
        },
        "tls_id": {
          "title": "Tls Id",
          "type": "string"
        }
      },
      "required": [
        "tls_id"
      ],
      "title": "TlsTarget",
      "type": "object"
    }
  },
  "description": "Emitted by the planner, one per phase; measured against gold plans. `network_id` is the\nnetwork the study is about (`FromStep` when the plan creates it). A plan always contains an\n`obtain_network` step (ADR-0037 \u00a72), so it is never empty.",
  "properties": {
    "network_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/FromStep"
        }
      ],
      "title": "Network Id"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "steps": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/ObtainNetworkStep"
          },
          {
            "$ref": "#/$defs/DeriveNetworkStep"
          },
          {
            "$ref": "#/$defs/ObtainDemandStep"
          },
          {
            "$ref": "#/$defs/RerouteDemandStep"
          },
          {
            "$ref": "#/$defs/BuildScenarioStep"
          },
          {
            "$ref": "#/$defs/RunSimulationStep"
          }
        ]
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "network_id",
    "rationale",
    "steps"
  ],
  "title": "StudyPlan",
  "type": "object"
}
