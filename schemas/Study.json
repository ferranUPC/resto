{
  "$defs": {
    "AddEdge": {
      "description": "`edge_id`, when given, is the id the new edge gets, so an intervention of the same arm can\ntarget it (ADR-0027).",
      "properties": {
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "from_junction": {
          "title": "From Junction",
          "type": "string"
        },
        "kind": {
          "const": "add_edge",
          "default": "add_edge",
          "title": "Kind",
          "type": "string"
        },
        "lanes": {
          "title": "Lanes",
          "type": "integer"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        },
        "to_junction": {
          "title": "To Junction",
          "type": "string"
        }
      },
      "required": [
        "from_junction",
        "to_junction",
        "lanes",
        "speed"
      ],
      "title": "AddEdge",
      "type": "object"
    },
    "Arm": {
      "properties": {
        "interventions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "title": "Interventions",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "topology_changes": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemoveEdge"
              },
              {
                "$ref": "#/$defs/AddEdge"
              },
              {
                "$ref": "#/$defs/SetLanes"
              },
              {
                "$ref": "#/$defs/SetSpeed"
              }
            ]
          },
          "title": "Topology Changes",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "Arm",
      "type": "object"
    },
    "Basis": {
      "enum": [
        "observed",
        "inferred",
        "extrapolated"
      ],
      "title": "Basis",
      "type": "string"
    },
    "BottleneckCause": {
      "description": "Why one edge of a diagnosed bottleneck is congested (ADR-0029). Declared in precedence\norder: when several apply, the first one is the edge's cause.",
      "enum": [
        "intervention",
        "merge",
        "spillback",
        "signal",
        "demand"
      ],
      "title": "BottleneckCause",
      "type": "string"
    },
    "BottleneckCauses": {
      "description": "The diagnostic \"why\": one `BottleneckCause` per edge of a diagnosed bottleneck\n(ADR-0029), stated next to the `Edges` value that ranks them.",
      "properties": {
        "causes": {
          "items": {
            "$ref": "#/$defs/EdgeCause"
          },
          "title": "Causes",
          "type": "array"
        },
        "kind": {
          "const": "causes",
          "default": "causes",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "causes"
      ],
      "title": "BottleneckCauses",
      "type": "object"
    },
    "BuildScenarioStep": {
      "description": "`arm`, `role` and `purpose` are the planner's: the Executor copies them into the\n`Experiment` this scenario and its runs become (ADR-0025 \u00a75, ADR-0027 \u00a73).",
      "properties": {
        "arm": {
          "title": "Arm",
          "type": "string"
        },
        "context_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Context Tags",
          "type": "array",
          "uniqueItems": true
        },
        "demand_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Demand Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "interventions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "title": "Interventions",
          "type": "array"
        },
        "kind": {
          "const": "build_scenario",
          "default": "build_scenario",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Network Id"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExperimentRole"
        }
      },
      "required": [
        "network_id",
        "demand_id",
        "arm",
        "role",
        "purpose"
      ],
      "title": "BuildScenarioStep",
      "type": "object"
    },
    "Change": {
      "description": "How a measure changes relative to a reference (usually the baseline): a direction and,\nwhen known, the relative change in percent.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/ChangeDirection"
        },
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "kind": {
          "const": "change",
          "default": "change",
          "title": "Kind",
          "type": "string"
        },
        "measure": {
          "$ref": "#/$defs/Measure"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Id"
        },
        "relative_change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Change Pct"
        }
      },
      "required": [
        "measure",
        "direction"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeDirection": {
      "enum": [
        "increase",
        "decrease",
        "unchanged"
      ],
      "title": "ChangeDirection",
      "type": "string"
    },
    "Claim": {
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Condition": {
      "description": "Runtime predicate `metric(target) op value` evaluated by the script's `when(...)`.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "op": {
          "$ref": "#/$defs/Operator"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "target",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Contrast": {
      "description": "`treatment` measured against `reference`, both arm labels (`BASE_ARM` included).",
      "properties": {
        "reference": {
          "default": "base",
          "title": "Reference",
          "type": "string"
        },
        "treatment": {
          "title": "Treatment",
          "type": "string"
        }
      },
      "required": [
        "treatment"
      ],
      "title": "Contrast",
      "type": "object"
    },
    "DemandNotNamed": {
      "description": "The request says nothing about the traffic and there is no default demand (ADR-0035 \u00a72).",
      "properties": {
        "kind": {
          "const": "demand_not_named",
          "default": "demand_not_named",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "DemandNotNamed",
      "type": "object"
    },
    "DemandNotObtainable": {
      "description": "The requested demand is not stored and no capability can obtain it (ADR-0035 \u00a73).",
      "properties": {
        "demand_ref": {
          "title": "Demand Ref",
          "type": "string"
        },
        "kind": {
          "const": "demand_not_obtainable",
          "default": "demand_not_obtainable",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "demand_ref"
      ],
      "title": "DemandNotObtainable",
      "type": "object"
    },
    "DeriveNetworkStep": {
      "properties": {
        "base_network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Base Network Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "kind": {
          "const": "derive_network",
          "default": "derive_network",
          "title": "Kind",
          "type": "string"
        },
        "max_rounds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rounds"
        },
        "min_scc_ratio": {
          "default": 0.95,
          "title": "Min Scc Ratio",
          "type": "number"
        },
        "modifications": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemoveEdge"
              },
              {
                "$ref": "#/$defs/AddEdge"
              },
              {
                "$ref": "#/$defs/SetLanes"
              },
              {
                "$ref": "#/$defs/SetSpeed"
              }
            ]
          },
          "title": "Modifications",
          "type": "array"
        },
        "probe_teleport_threshold": {
          "default": 0,
          "title": "Probe Teleport Threshold",
          "type": "integer"
        }
      },
      "required": [
        "base_network_id",
        "modifications"
      ],
      "title": "DeriveNetworkStep",
      "type": "object"
    },
    "EdgeCause": {
      "properties": {
        "cause": {
          "$ref": "#/$defs/BottleneckCause"
        },
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "network_id": {
          "title": "Network Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "network_id",
        "cause"
      ],
      "title": "EdgeCause",
      "type": "object"
    },
    "EdgeTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "edge",
          "default": "edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "edge_id"
      ],
      "title": "EdgeTarget",
      "type": "object"
    },
    "Edges": {
      "description": "A set of edges, or a ranking when `ranked` (most relevant first). Empty is a valid\nanswer (\"no edge does\").",
      "properties": {
        "edge_ids": {
          "items": {
            "type": "string"
          },
          "title": "Edge Ids",
          "type": "array"
        },
        "kind": {
          "const": "edges",
          "default": "edges",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "title": "Network Id",
          "type": "string"
        },
        "ranked": {
          "default": false,
          "title": "Ranked",
          "type": "boolean"
        }
      },
      "required": [
        "edge_ids",
        "network_id"
      ],
      "title": "Edges",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "artifact",
        "query"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Experiment": {
      "description": "One scenario and its seeded runs, inside a Study. `arm` is the question's arm it realises\n(ADR-0027); `reused` marks a scenario the Executor found by the hash of its request, with ok\nresults, and so did not send to the Scenario Builder (ADR-0037 \u00a75).",
      "properties": {
        "arm": {
          "title": "Arm",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "result_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Result Ids",
          "type": "array"
        },
        "reused": {
          "default": false,
          "title": "Reused",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/ExperimentRole"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "arm",
        "role",
        "purpose"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentRole": {
      "enum": [
        "baseline",
        "treatment",
        "comparison"
      ],
      "title": "ExperimentRole",
      "type": "string"
    },
    "ExpertAnswer": {
      "description": "`values` is the answer itself, typed; `answer` is the prose justification. When they\ndisagree, `values` is authoritative (ADR-0019).",
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "needs_simulation": {
          "default": false,
          "title": "Needs Simulation",
          "type": "boolean"
        },
        "proposed_experiment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Edges"
              },
              {
                "$ref": "#/$defs/Quantity"
              },
              {
                "$ref": "#/$defs/Change"
              },
              {
                "$ref": "#/$defs/NoValue"
              },
              {
                "$ref": "#/$defs/BottleneckCauses"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "answer",
        "basis",
        "confidence"
      ],
      "title": "ExpertAnswer",
      "type": "object"
    },
    "ExpertRound": {
      "description": "One iteration of the Expert <-> Simulation loop inside a Study. `forced_by_limit` marks the\nlast round of a free study, sent in forced mode because the rounds ran out (ADR-0025 \u00a74).",
      "properties": {
        "answer": {
          "$ref": "#/$defs/ExpertAnswer"
        },
        "forced_by_limit": {
          "default": false,
          "title": "Forced By Limit",
          "type": "boolean"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "ExpertRound",
      "type": "object"
    },
    "FoundItem": {
      "description": "Something the specialist already found when it had to stop.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "what": {
          "enum": [
            "network",
            "demand"
          ],
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "what",
        "id"
      ],
      "title": "FoundItem",
      "type": "object"
    },
    "FromStep": {
      "description": "The id produced by step `step` of the same plan.",
      "properties": {
        "step": {
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "step"
      ],
      "title": "FromStep",
      "type": "object"
    },
    "Intent": {
      "enum": [
        "describe",
        "diagnose",
        "compare",
        "run"
      ],
      "title": "Intent",
      "type": "string"
    },
    "Intervention": {
      "description": "Something that happens *during* a simulation on an unchanged network.\n\nPermanent topology changes are not interventions: see TopologyModification.",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Effect"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeTarget"
            },
            {
              "$ref": "#/$defs/LaneTarget"
            },
            {
              "$ref": "#/$defs/TlsTarget"
            },
            {
              "$ref": "#/$defs/TazTarget"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "type": {
          "$ref": "#/$defs/InterventionType"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionType": {
      "enum": [
        "lane_closure",
        "edge_closure",
        "speed_limit",
        "demand_scale",
        "signal_program",
        "custom"
      ],
      "title": "InterventionType",
      "type": "string"
    },
    "LaneTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "lane",
          "default": "lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "LaneTarget",
      "type": "object"
    },
    "Measure": {
      "description": "What a typed answer measures. The unit is fixed by the measure (`unit`), so an answer\ncan never be stated in a different one. `time_loss` and `waiting_time` are totals summed over\nevery vehicle on the edge (vehicle-seconds), not per-vehicle means (ADR-0020).",
      "enum": [
        "travel_time",
        "time_loss",
        "waiting_time",
        "occupancy",
        "speed",
        "density",
        "entered",
        "left",
        "mean_delay",
        "mean_travel_time",
        "teleports",
        "departed",
        "arrived"
      ],
      "title": "Measure",
      "type": "string"
    },
    "Metric": {
      "enum": [
        "occupancy",
        "speed",
        "vehicle_count"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Mode": {
      "enum": [
        "free",
        "forced"
      ],
      "title": "Mode",
      "type": "string"
    },
    "NeedsUser": {
      "description": "The user must act: the specialist is done with this request (ADR-0037 \u00a74).\n\n`message` is the specialist's account of what it was asked, what it cannot do and why. The\ncode derives the default recommendation from `reason`; `advice` is the specialist's own, on\ntop of it.",
      "properties": {
        "advice": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Advice",
          "type": "array"
        },
        "candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "found": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FoundItem"
          },
          "title": "Found",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowMissing"
            },
            {
              "$ref": "#/$defs/DemandNotNamed"
            },
            {
              "$ref": "#/$defs/DemandNotObtainable"
            },
            {
              "$ref": "#/$defs/NetworkNotFound"
            },
            {
              "$ref": "#/$defs/SeveralCandidates"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "reason",
        "message"
      ],
      "title": "NeedsUser",
      "type": "object"
    },
    "NetworkNotFound": {
      "description": "No stored network matches the name and it gives no way to build one (ADR-0035 \u00a76).",
      "properties": {
        "kind": {
          "const": "network_not_found",
          "default": "network_not_found",
          "title": "Kind",
          "type": "string"
        },
        "network_ref": {
          "title": "Network Ref",
          "type": "string"
        }
      },
      "required": [
        "network_ref"
      ],
      "title": "NetworkNotFound",
      "type": "object"
    },
    "NoValue": {
      "description": "The data shows the measure is undefined, e.g. the mean travel time of an edge no vehicle\ncrossed. Not an abstention: the answer rests on evidence (ADR-0021). Only per-vehicle means can\nbe undefined; a 0 % occupancy or a zero total delay is a real value.",
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "no_value",
          "default": "no_value",
