{
  "$defs": {
    "AddEdge": {
      "properties": {
        "from_junction": {
          "title": "From Junction",
          "type": "string"
        },
        "kind": {
          "const": "add_edge",
          "default": "add_edge",
          "title": "Kind",
          "type": "string"
        },
        "lanes": {
          "title": "Lanes",
          "type": "integer"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        },
        "to_junction": {
          "title": "To Junction",
          "type": "string"
        }
      },
      "required": [
        "from_junction",
        "to_junction",
        "lanes",
        "speed"
      ],
      "title": "AddEdge",
      "type": "object"
    },
    "ArtifactRef": {
      "description": "Reference to a file in the artifact store, identified by content hash.",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Basis": {
      "enum": [
        "observed",
        "inferred",
        "extrapolated"
      ],
      "title": "Basis",
      "type": "string"
    },
    "BuildScenarioStep": {
      "description": "`role` and `purpose` are the Coordinator's: the Executor copies them into the `Experiment`\nthis scenario and its runs become (ADR-0025 \u00a75).",
      "properties": {
        "allow_script": {
          "default": true,
          "title": "Allow Script",
          "type": "boolean"
        },
        "context_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Context Tags",
          "type": "array",
          "uniqueItems": true
        },
        "demand_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Demand Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "interventions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "title": "Interventions",
          "type": "array"
        },
        "kind": {
          "const": "build_scenario",
          "default": "build_scenario",
          "title": "Kind",
          "type": "string"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Network Id"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ExperimentRole"
        }
      },
      "required": [
        "network_id",
        "demand_id",
        "role",
        "purpose"
      ],
      "title": "BuildScenarioStep",
      "type": "object"
    },
    "Change": {
      "description": "How a measure changes relative to a reference (usually the baseline): a direction and,\nwhen known, the relative change in percent.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/ChangeDirection"
        },
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "kind": {
          "const": "change",
          "default": "change",
          "title": "Kind",
          "type": "string"
        },
        "measure": {
          "$ref": "#/$defs/Measure"
        },
        "relative_change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Change Pct"
        }
      },
      "required": [
        "measure",
        "direction"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeDirection": {
      "enum": [
        "increase",
        "decrease",
        "unchanged"
      ],
      "title": "ChangeDirection",
      "type": "string"
    },
    "Claim": {
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClarificationRequest": {
      "description": "The Coordinator's other possible output: an ambiguity only the database reveals, e.g. two\nnetworks labelled \"Gran Via\". `candidates` are what the user picks from.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ClarificationRequest",
      "type": "object"
    },
    "Condition": {
      "description": "Runtime predicate `metric(target) op value` evaluated by the script's `when(...)`.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "op": {
          "$ref": "#/$defs/Operator"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "target",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DemandProfile": {
      "enum": [
        "low",
        "peak",
        "incident",
        "custom"
      ],
      "title": "DemandProfile",
      "type": "string"
    },
    "DeriveNetworkStep": {
      "properties": {
        "base_network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Base Network Id"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "kind": {
          "const": "derive_network",
          "default": "derive_network",
          "title": "Kind",
          "type": "string"
        },
        "max_rounds": {
          "default": 5,
          "title": "Max Rounds",
          "type": "integer"
        },
        "min_scc_ratio": {
          "default": 0.95,
          "title": "Min Scc Ratio",
          "type": "number"
        },
        "modifications": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemoveEdge"
              },
              {
                "$ref": "#/$defs/AddEdge"
              },
              {
                "$ref": "#/$defs/SetLanes"
              },
              {
                "$ref": "#/$defs/SetSpeed"
              }
            ]
          },
          "title": "Modifications",
          "type": "array"
        },
        "probe_teleport_threshold": {
          "default": 0,
          "title": "Probe Teleport Threshold",
          "type": "integer"
        }
      },
      "required": [
        "base_network_id",
        "modifications"
      ],
      "title": "DeriveNetworkStep",
      "type": "object"
    },
    "EdgeTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "edge",
          "default": "edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "edge_id"
      ],
      "title": "EdgeTarget",
      "type": "object"
    },
    "Edges": {
      "description": "A set of edges, or a ranking when `ranked` (most relevant first). Empty is a valid\nanswer (\"no edge does\").",
      "properties": {
        "edge_ids": {
          "items": {
            "type": "string"
          },
          "title": "Edge Ids",
          "type": "array"
        },
        "kind": {
          "const": "edges",
          "default": "edges",
          "title": "Kind",
          "type": "string"
        },
        "ranked": {
          "default": false,
          "title": "Ranked",
          "type": "boolean"
        }
      },
      "required": [
        "edge_ids"
      ],
      "title": "Edges",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "artifact",
        "query"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "Experiment": {
      "description": "One scenario and its seeded runs, inside a Study. `reused` marks a scenario whose stored\nresults the plan reused instead of running it now (ADR-0025 \u00a71).",
      "properties": {
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "result_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Result Ids",
          "type": "array"
        },
        "reused": {
          "default": false,
          "title": "Reused",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/ExperimentRole"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "role",
        "purpose"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentRole": {
      "enum": [
        "baseline",
        "treatment",
        "comparison"
      ],
      "title": "ExperimentRole",
      "type": "string"
    },
    "ExpertAnswer": {
      "description": "`values` is the answer itself, typed; `answer` is the prose justification. When they\ndisagree, `values` is authoritative (ADR-0019).",
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "needs_simulation": {
          "default": false,
          "title": "Needs Simulation",
          "type": "boolean"
        },
        "proposed_experiment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Edges"
              },
              {
                "$ref": "#/$defs/Quantity"
              },
              {
                "$ref": "#/$defs/Change"
              },
              {
                "$ref": "#/$defs/NoValue"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "answer",
        "basis",
        "confidence"
      ],
      "title": "ExpertAnswer",
      "type": "object"
    },
    "ExpertRound": {
      "description": "One iteration of the Expert <-> Simulation loop inside a Study. `forced_by_limit` marks the\nlast round of a free study, sent in forced mode because the rounds ran out (ADR-0025 \u00a74).",
      "properties": {
        "answer": {
          "$ref": "#/$defs/ExpertAnswer"
        },
        "forced_by_limit": {
          "default": false,
          "title": "Forced By Limit",
          "type": "boolean"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "ExpertRound",
      "type": "object"
    },
    "ExternalDatasetSource": {
      "description": "Data the Demand Generator found outside, frozen as an artifact so the demand is\nreproducible even if the URL changes.",
      "properties": {
        "kind": {
          "const": "external_dataset",
          "default": "external_dataset",
          "title": "Kind",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "transformation": {
          "title": "Transformation",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "snapshot",
        "transformation"
      ],
      "title": "ExternalDatasetSource",
      "type": "object"
    },
    "FromStep": {
      "description": "The id produced by step `step` of the same plan.",
      "properties": {
        "step": {
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "step"
      ],
      "title": "FromStep",
      "type": "object"
    },
    "GenerateDemandStep": {
      "properties": {
        "control_edges": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Control Edges",
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "generate_demand",
          "default": "generate_demand",
          "title": "Kind",
          "type": "string"
        },
        "max_calibration_rounds": {
          "default": 5,
          "title": "Max Calibration Rounds",
          "type": "integer"
        },
        "network_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/FromStep"
            }
          ],
          "title": "Network Id"
        },
        "profile": {
          "$ref": "#/$defs/DemandProfile"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "sources": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ParametersSource"
              },
              {
                "$ref": "#/$defs/HistoricalDbSource"
              },
              {
                "$ref": "#/$defs/ExternalDatasetSource"
              }
            ]
          },
          "title": "Sources",
          "type": "array"
        },
        "tolerance": {
          "default": 0.15,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "network_id",
        "profile",
        "seed"
      ],
      "title": "GenerateDemandStep",
      "type": "object"
    },
    "GenerateNetworkStep": {
      "properties": {
        "depends_on": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "kind": {
          "const": "generate_network",
          "default": "generate_network",
          "title": "Kind",
          "type": "string"
        },
        "max_rounds": {
          "default": 5,
          "title": "Max Rounds",
          "type": "integer"
        },
        "min_scc_ratio": {
          "default": 0.95,
          "title": "Min Scc Ratio",
          "type": "number"
        },
        "modifications": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/RemoveEdge"
              },
              {
                "$ref": "#/$defs/AddEdge"
              },
              {
                "$ref": "#/$defs/SetLanes"
              },
              {
                "$ref": "#/$defs/SetSpeed"
              }
            ]
          },
          "title": "Modifications",
          "type": "array"
        },
        "probe_teleport_threshold": {
          "default": 0,
          "title": "Probe Teleport Threshold",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/NetworkSource"
        }
      },
      "required": [
        "source"
      ],
      "title": "GenerateNetworkStep",
      "type": "object"
    },
    "HistoricalDbSource": {
      "properties": {
        "kind": {
          "const": "historical_db",
          "default": "historical_db",
          "title": "Kind",
          "type": "string"
        },
        "query": {
          "additionalProperties": true,
          "title": "Query",
          "type": "object"
        }
      },
      "title": "HistoricalDbSource",
      "type": "object"
    },
    "Intent": {
      "enum": [
        "describe",
        "diagnose",
        "counterfactual",
        "compare",
        "run"
      ],
      "title": "Intent",
      "type": "string"
    },
    "Intervention": {
      "description": "Something that happens *during* a simulation on an unchanged network.\n\nPermanent topology changes are not interventions: see TopologyModification.",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Effect"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeTarget"
            },
            {
              "$ref": "#/$defs/LaneTarget"
            },
            {
              "$ref": "#/$defs/TlsTarget"
            },
            {
              "$ref": "#/$defs/TazTarget"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "type": {
          "$ref": "#/$defs/InterventionType"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionType": {
      "enum": [
        "lane_closure",
        "edge_closure",
        "speed_limit",
        "demand_scale",
        "signal_program",
        "custom"
      ],
      "title": "InterventionType",
      "type": "string"
    },
    "LaneTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "lane",
          "default": "lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "LaneTarget",
      "type": "object"
    },
    "Measure": {
      "description": "What a typed answer measures. The unit is fixed by the measure (`unit`), so an answer\ncan never be stated in a different one. `time_loss` and `waiting_time` are totals summed over\nevery vehicle on the edge (vehicle-seconds), not per-vehicle means (ADR-0020).",
      "enum": [
        "travel_time",
        "time_loss",
        "waiting_time",
        "occupancy",
        "speed",
        "density",
        "entered",
        "left",
        "mean_delay",
        "mean_travel_time",
        "teleports",
        "departed",
        "arrived"
      ],
      "title": "Measure",
      "type": "string"
    },
    "Metric": {
      "enum": [
        "occupancy",
        "speed",
        "vehicle_count"
      ],
      "title": "Metric",
      "type": "string"
    },
    "Mode": {
      "enum": [
        "free",
        "forced"
      ],
      "title": "Mode",
      "type": "string"
    },
    "NetworkSource": {
      "properties": {
        "kind": {
          "enum": [
            "place",
            "bbox",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "NetworkSource",
      "type": "object"
    },
    "NoValue": {
      "description": "The data shows the measure is undefined, e.g. the mean travel time of an edge no vehicle\ncrossed. Not an abstention: the answer rests on evidence (ADR-0021). Only per-vehicle means can\nbe undefined; a 0 % occupancy or a zero total delay is a real value.",
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "no_value",
          "default": "no_value",
          "title": "Kind",
          "type": "string"
        },
        "measure": {
          "$ref": "#/$defs/Measure"
        },
        "reason": {
          "$ref": "#/$defs/NoValueReason",
          "default": "no_traffic"
        }
      },
      "required": [
        "measure",
        "edge_id"
      ],
      "title": "NoValue",
      "type": "object"
    },
    "NoValueReason": {
      "enum": [
        "no_traffic"
      ],
      "title": "NoValueReason",
      "type": "string"
    },
    "Operator": {
      "enum": [
        ">",
        ">=",
        "<",
        "<="
      ],
      "title": "Operator",
      "type": "string"
    },
    "ParametersSource": {
      "properties": {
        "kind": {
          "const": "parameters",
          "default": "parameters",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ParametersSource",
      "type": "object"
    },
    "Phase": {
