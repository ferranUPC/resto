{
  "$defs": {
    "ArtifactRef": {
      "description": "Reference to a file in the artifact store, identified by content hash.",
      "properties": {
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content_hash",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AtTime": {
      "description": "Fires once, when the simulation time reaches `t` seconds.",
      "properties": {
        "kind": {
          "const": "at_time",
          "default": "at_time",
          "title": "Kind",
          "type": "string"
        },
        "t": {
          "title": "T",
          "type": "number"
        }
      },
      "required": [
        "t"
      ],
      "title": "AtTime",
      "type": "object"
    },
    "CloseLane": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "close_lane",
          "default": "close_lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "CloseLane",
      "type": "object"
    },
    "Condition": {
      "description": "Runtime predicate `metric(target) op value` evaluated by the script's `when(...)`.",
      "properties": {
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "op": {
          "$ref": "#/$defs/Operator"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "target",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "EdgeTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "edge",
          "default": "edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "edge_id"
      ],
      "title": "EdgeTarget",
      "type": "object"
    },
    "Intervention": {
      "description": "Something that happens *during* a simulation on an unchanged network.\n\nPermanent topology changes are not interventions: see TopologyModification.",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "expected_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Effect"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeTarget"
            },
            {
              "$ref": "#/$defs/LaneTarget"
            },
            {
              "$ref": "#/$defs/TlsTarget"
            },
            {
              "$ref": "#/$defs/TazTarget"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "type": {
          "$ref": "#/$defs/InterventionType"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionType": {
      "enum": [
        "lane_closure",
        "edge_closure",
        "speed_limit",
        "demand_scale",
        "signal_program",
        "custom"
      ],
      "title": "InterventionType",
      "type": "string"
    },
    "LaneTarget": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "lane",
          "default": "lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "LaneTarget",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "occupancy",
        "speed",
        "vehicle_count"
      ],
      "title": "Metric",
      "type": "string"
    },
    "OpenLane": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "open_lane",
          "default": "open_lane",
          "title": "Kind",
          "type": "string"
        },
        "lane_index": {
          "title": "Lane Index",
          "type": "integer"
        }
      },
      "required": [
        "edge_id",
        "lane_index"
      ],
      "title": "OpenLane",
      "type": "object"
    },
    "Operator": {
      "enum": [
        ">",
        ">=",
        "<",
        "<="
      ],
      "title": "Operator",
      "type": "string"
    },
    "RegenerateDemandMechanism": {
      "description": "Intervention implemented by pointing the scenario at a derived Demand (demand_scale).",
      "properties": {
        "demand_id": {
          "title": "Demand Id",
          "type": "string"
        },
        "kind": {
          "const": "regenerate_demand",
          "default": "regenerate_demand",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "demand_id"
      ],
      "title": "RegenerateDemandMechanism",
      "type": "object"
    },
    "Rule": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/CloseLane"
            },
            {
              "$ref": "#/$defs/OpenLane"
            },
            {
              "$ref": "#/$defs/SetSpeed"
            },
            {
              "$ref": "#/$defs/SetTlsProgram"
            }
          ],
          "title": "Action"
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/AtTime"
            },
            {
              "$ref": "#/$defs/When"
            }
          ],
          "title": "Trigger"
        }
      },
      "required": [
        "trigger",
        "action"
      ],
      "title": "Rule",
      "type": "object"
    },
    "ScriptMechanism": {
      "description": "Intervention implemented inside the scenario's traci_api script.",
      "properties": {
        "kind": {
          "const": "script",
          "default": "script",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ScriptMechanism",
      "type": "object"
    },
    "SetSpeed": {
      "description": "Sets the maximum speed of an edge, in m/s. Not the network-level `SetSpeed` of\n`topology_modification`, which edits the network file.",
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "set_speed",
          "default": "set_speed",
          "title": "Kind",
          "type": "string"
        },
        "speed": {
          "title": "Speed",
          "type": "number"
        }
      },
      "required": [
        "edge_id",
        "speed"
      ],
      "title": "SetSpeed",
      "type": "object"
    },
    "SetTlsProgram": {
      "properties": {
        "kind": {
          "const": "set_tls_program",
          "default": "set_tls_program",
          "title": "Kind",
          "type": "string"
        },
        "program_id": {
          "title": "Program Id",
          "type": "string"
        },
        "tls_id": {
          "title": "Tls Id",
          "type": "string"
        }
      },
      "required": [
        "tls_id",
        "program_id"
      ],
      "title": "SetTlsProgram",
      "type": "object"
    },
    "StaticFileMechanism": {
      "description": "Intervention implemented as a SUMO additional file (rerouter, VSS, TLS program, TAZ).",
      "properties": {
        "file_kind": {
          "enum": [
            "rerouter",
            "vss",
            "tls_program",
            "taz"
          ],
          "title": "File Kind",
          "type": "string"
        },
        "kind": {
          "const": "static_file",
          "default": "static_file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "file_kind",
        "path"
      ],
      "title": "StaticFileMechanism",
      "type": "object"
    },
    "TazTarget": {
      "properties": {
        "kind": {
          "const": "taz",
          "default": "taz",
          "title": "Kind",
          "type": "string"
        },
        "taz_id": {
          "title": "Taz Id",
          "type": "string"
        }
      },
      "required": [
        "taz_id"
      ],
      "title": "TazTarget",
      "type": "object"
    },
    "TimeWindow": {
      "description": "Time of day in seconds since midnight, [start, end): 08:00\u201309:00 is [28800, 32400).\nSimulations run on the same clock (ADR-0028); past midnight the count continues.",
      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "TlsTarget": {
      "properties": {
        "kind": {
          "const": "tls",
          "default": "tls",
          "title": "Kind",
          "type": "string"
        },
        "tls_id": {
          "title": "Tls Id",
          "type": "string"
        }
      },
      "required": [
        "tls_id"
      ],
      "title": "TlsTarget",
      "type": "object"
    },
    "TraciScript": {
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "TraciScript",
      "type": "object"
    },
    "When": {
      "description": "Fires each time `condition` goes from false to true.",
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "kind": {
          "const": "when",
          "default": "when",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "condition"
      ],
      "title": "When",
      "type": "object"
    }
  },
  "description": "A runnable SUMO configuration for (network, demand, interventions).\n`scenario_id` is the hash of the request, not of the files (see ids.scenario_id_for).",
  "properties": {
    "additional_files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Additional Files",
      "type": "array"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "context_tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Context Tags",
      "type": "array",
      "uniqueItems": true
    },
    "demand_id": {
      "title": "Demand Id",
      "type": "string"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "title": "Interventions",
      "type": "array"
    },
    "mechanisms": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/StaticFileMechanism"
          },
          {
            "$ref": "#/$defs/ScriptMechanism"
          },
          {
            "$ref": "#/$defs/RegenerateDemandMechanism"
          }
        ]
      },
      "title": "Mechanisms",
      "type": "array"
    },
    "network_id": {
      "title": "Network Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "sumocfg": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "traci_script": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraciScript"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "scenario_id",
    "network_id",
    "demand_id",
    "interventions",
    "mechanisms",
    "sumocfg",
    "content_hash"
  ],
  "title": "Scenario",
  "type": "object"
}
